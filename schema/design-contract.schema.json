{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hirokaji/jp-ui-contracts/schema/design-contract.schema.json",
  "title": "jp-ui-contracts Design Contract Projection",
  "description": "Machine-readable projection exported from DESIGN.md. DESIGN.md remains the human-edited source.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"type": "string", "const": "0.2.0"},
    "source": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "const": "ja-JP"},
    "profile": {
      "type": "string",
      "enum": ["base", "media", "saas", "docs", "dashboard"]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "verified", "production"]
    },
    "writingMode": {"type": "string"},
    "targetSurfaces": {"type": "string"},
    "lastReviewedAt": {"type": "string"},
    "reviewer": {"type": "string"},
    "validationTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "source",
    "locale",
    "profile",
    "reviewStatus",
    "validationTargets"
  ]
}
